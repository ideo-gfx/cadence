# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase project settings > API > service_role key. Server only, never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public URL of the app (used in sign-in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daily report and reminder emails (phase 5). Off until Resend is set up.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Cadence <cadence@ideogfx.com>
# Any long random string. Vercel Cron sends it to /api/cron/* automatically.
CRON_SECRET=
# Optional: working days as ISO weekdays (1 = Monday). Default Monday to Friday.
# NEXT_PUBLIC_WORK_DAYS=1,2,3,4,5
